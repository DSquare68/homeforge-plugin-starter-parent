# Build output
target/

# Eclipse / m2e
.project
.classpath
.factorypath
.settings/
.eclipse/
.vaadin/

# Other IDEs
.idea/
.vscode/
*.iml

.DS_Store

# Generated by vaadin-maven-plugin
node_modules/
src/main/frontend/generated/
vite.generated.ts

# HUB writes <plugin-id>.properties — the plugin's PostgreSQL role and a
# generated password — into the jar at install time, which lands at the
# resources root when exploded. Never commit it. Add a negation below if a
# plugin genuinely needs to track a properties file at that exact location.
**/src/main/resources/*.properties
.env
